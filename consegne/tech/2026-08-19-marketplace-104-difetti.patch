+  SELECT count(*)::int FROM public.event_rsvps WHERE event_id = p_event_id;
+$$;
+
+CREATE OR REPLACE FUNCTION public.event_rsvp_counts()
+RETURNS TABLE (event_id uuid, partecipanti int)
