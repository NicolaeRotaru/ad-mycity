+DROP POLICY IF EXISTS shop_of_month_votes_public_read ON public.shop_of_month_votes;
+
+CREATE OR REPLACE FUNCTION public.event_rsvp_count(p_event_id uuid)
+RETURNS int
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public
