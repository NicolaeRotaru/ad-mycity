+  ON public.products FOR INSERT
+  TO authenticated
+  WITH CHECK (
+    seller_id = (SELECT auth.uid())
+    AND EXISTS (
+      SELECT 1 FROM public.profiles p
+       WHERE p.id = (SELECT auth.uid())
