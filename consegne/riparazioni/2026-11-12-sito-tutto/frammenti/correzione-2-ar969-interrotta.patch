+// ─── ⑨ scrivere una copia finta non è raggiungere il file vero (secondo giro di correzione) ──
+
+test("⑨ parteCheRaggiungeInProva: una copia FINTA scritta in una cartella temporanea non raggiunge il file vero", () => {
+  for (const riga of [
+    'writeFileSync(join(tmp, "cervello/a.mjs"), "export const x = 1;\\n");',
+    'fs.writeFileSync(join(dir, "cervello", "a.mjs"), FINTO);',
+    'await writeFile(resolve(tmp, "cervello/a.mjs"), FINTO, "utf8");',
+    'appendFileSync(join(tmp, "cervello/a.mjs"), "\\n");',
+    'mkdirSync(join(tmp, "cervello/a.mjs"), { recursive: true });',
+  ]) {
+    assert.ok(!parteCheRaggiungeInProva(riga).includes("a.mjs"), riga);
+  }
+  // Copiare o leggere il file vero invece lo raggiunge, anche dentro una scrittura.
+  for (const riga of [
+    'copyFileSync(join(REPO, "cervello/a.mjs"), join(tmp, "cervello/a.mjs"));',
+    'writeFileSync(join(tmp, "b.mjs"), readFileSync(join(REPO, "cervello/a.mjs"), "utf8"));',
+  ]) {
+    assert.ok(parteCheRaggiungeInProva(riga).split("\n").includes("cervello/a.mjs"), riga);
+  }
+});
+
