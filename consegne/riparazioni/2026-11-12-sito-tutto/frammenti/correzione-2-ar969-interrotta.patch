+test("⑧ chi parte da solo resta vivo: un flusso, un hook, un'unità, una prova e una rotta del Pannello cancellati danno le loro voci", () => {
+  for (const [file, riga] of [
+    [".github/workflows/notte.yml", "      - run: node cervello/gate-veri.mjs"],
+    [".githooks/pre-commit", "node cervello/gate-veri.mjs || exit 1"],
+    ["cervello/vps/mycity-gate.service", "ExecStart=/usr/bin/env node /opt/mycity/ad-mycity/cervello/gate-veri.mjs"],
+    ["pannello/src/lib/carrello.test.mts", 'const r = spawnSync("node", [join(REPO, "cervello/gate-veri.mjs")]);'],
+    // La forma vera di pannello/src/app/api/notifica/route.ts: la rotta passa il freno al worker.
+    ["pannello/src/app/api/notifica/route.ts", '      `Invia questo AVVISO a Nicola tramite la "mano" disponibile (via cervello/esegui-azione.mjs): "${t}".`,'],
+  ]) {
