#!/usr/bin/env bash
# 🔒 pre-commit — quattro cancelli su OGNI commit (non solo nel giro):
#   1) 🩺 SINTASSI shell: nessun .sh/.bash rotto entra nella storia (worker-outage 2026-07-09).
#   1b) 🩺 SINTASSI JavaScript: nessun .mjs/.cjs/.js rotto entra nella storia (AR-134).
#   2) 🧱 PERIMETRO DI MAIN: il codice su main ci arriva da una PR, non da un commit a mano (AR-332).
#   3) 🔑 SEGRETI: nessun token reale entra nella storia (AR-004).
#
# Ordine voluto: la sintassi gira PER PRIMA e serve solo `bash` — così vale anche sulle macchine
# senza node, dove lo scan-segreti si limita ad avvisare. Un cancello che si spegne se manca uno
# strumento non è un cancello.
#
# Installazione: `git config core.hooksPath .githooks` (versionato, lo fa cervello/installa-hooks.sh
# e il setup del VPS). Bypass di emergenza consapevole: `git commit --no-verify` (sconsigliato).

set -u

# Radice del repo (funziona anche se il commit parte da una sottocartella).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
SCAN="$ROOT/cervello/scan-segreti.mjs"

# ─────────────────────────────────────────────────────────────────────────────
# 1) 🩺 GATE DI SINTASSI SHELL — la causa radice del worker-outage del 2026-07-09 fu un worker.sh con
#    un errore di sintassi (case *contenuti pro* con spazio non quotato) committato e spinto su main:
#    sul VPS bash non riusciva più a leggerlo e il worker moriva a ogni avvio. Difesa: ogni .sh/.bash
#    staged DEVE passare `bash -n` (solo sintassi, non esegue nulla) PRIMA di entrare nella storia.
if command -v bash >/dev/null 2>&1; then
  _sh_rotti=""
  while IFS= read -r f; do
    case "$f" in
      *.sh|*.bash) ;;
      *) continue ;;
    esac
    # Controlla il CONTENUTO STAGED (git show :file), cioè ciò che verrà davvero committato.
    if ! git show ":$f" 2>/dev/null | bash -n 2>/dev/null; then
      _sh_rotti="$_sh_rotti $f"
    fi
  done < <(git diff --cached --name-only --diff-filter=ACM)
  if [ -n "$_sh_rotti" ]; then
    echo "" >&2
    echo "⛔ COMMIT BLOCCATO — errore di SINTASSI shell (bash -n) in:$_sh_rotti" >&2
    for f in $_sh_rotti; do
      echo "  → $f:" >&2
      git show ":$f" 2>/dev/null | bash -n 2>&1 | head -3 | sed 's/^/     /' >&2 || true
    done
    echo "" >&2
    echo "Correggi la sintassi e ri-committa. Bypass consapevole (sconsigliato): git commit --no-verify." >&2
    exit 1
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# 1b) 🩺 GATE DI SINTASSI JAVASCRIPT (AR-134) — stessa classe di rischio del gate shell qui sopra,
#    stessa difesa. Il worker-outage nacque da un .sh rotto, ma il cervello gira soprattutto su .mjs:
#    un git-github.mjs con un errore di sintassi ferma il giro esattamente come un worker.sh rotto —
#    e lì il gate non c'era, perché era stato scritto in reazione a UN incidente shell invece che per
#    la CLASSE «ogni artefatto eseguibile che entra nella storia deve almeno essere parsabile».
#
#    `node --check` non esegue nulla: legge e basta. Da stdin però perde il modulo ESM (avvisa e passa),
#    quindi il contenuto staged va scritto in un file temporaneo con la STESSA estensione — è
#    l'estensione a decidere se il file è un modulo. Fail-closed solo se node c'è (coerente col
#    principio in cima: un cancello che si spegne se manca uno strumento non è un cancello, ma su una
#    macchina senza node non c'è nemmeno il rischio di eseguirlo).
if command -v node >/dev/null 2>&1; then
  _js_rotti=""
  _js_tmpdir="$(mktemp -d 2>/dev/null || echo '')"
  if [ -n "$_js_tmpdir" ]; then
    while IFS= read -r f; do
      case "$f" in
        *.mjs|*.cjs|*.js) ;;
        *) continue ;;
      esac
      _ext="${f##*.}"
      _tmp="$_js_tmpdir/check.$_ext"
      git show ":$f" > "$_tmp" 2>/dev/null || continue
      if ! node --check "$_tmp" >/dev/null 2>&1; then
        _js_rotti="$_js_rotti $f"
      fi
    done < <(git diff --cached --name-only --diff-filter=ACM)
    if [ -n "$_js_rotti" ]; then
      echo "" >&2
      echo "⛔ COMMIT BLOCCATO — errore di SINTASSI JavaScript (node --check) in:$_js_rotti" >&2
      for f in $_js_rotti; do
        _ext="${f##*.}"
        _tmp="$_js_tmpdir/check.$_ext"
        git show ":$f" > "$_tmp" 2>/dev/null || true
        echo "  → $f:" >&2
        node --check "$_tmp" 2>&1 | head -4 | sed 's/^/     /' >&2 || true
      done
      rm -rf "$_js_tmpdir"
      echo "" >&2
      echo "Correggi la sintassi e ri-committa. Bypass consapevole (sconsigliato): git commit --no-verify." >&2
      exit 1
    fi
    rm -rf "$_js_tmpdir"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# 2) 🧱 PERIMETRO DI MAIN (AR-332) — su `main` si committa MEMORIA, non codice.
#
# Il 27/7, lavorando al lotto 6, un modulo nuovo è finito su main dentro un commit di memoria invece
# che nella sua PR: è bastato un `git add -A` a mano. Il gate di pubblicazione costruito nel lotto 3
# (AR-314) non l'ha visto perché è una FUNZIONE che i cinque script chiamano — e chi non la chiama non
# la incontra. Una regola che vale per il REPOSITORY era implementata come una funzione da invocare.
#
# Qui diventa un cancello che il repository impone, a chiunque committi: worker, giro, sessioni AD,
# persone. Sui rami di lavoro non blocca niente — è solo main ad avere il perimetro, perché è il ramo
# che il Pannello legge e da cui parte il deploy del Pannello.
#
# La regola è la STESSA di gate-pubblicazione.sh: si importa, non si ricopia. Due copie di un
# perimetro non sono un perimetro — è esattamente il difetto che questo cancello esiste per impedire.
#
# ⚠️ STA QUI, PRIMA del gate segreti, e non in fondo: quello esce 0 quando node o lo scanner mancano
# (scelta giusta, per non rompere i commit su una macchina spoglia), quindi tutto ciò che gli sta
# DOPO non verrebbe mai raggiunto. Ci ero cascato scrivendolo, e l'ha trovato il test provandolo in
# un repo senza scanner. È il principio già scritto in cima a questo file: un cancello che si spegne
# se manca uno strumento non è un cancello. Questo serve solo bash e git.
_ramo="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
if [ "$_ramo" = "main" ] && [ -f "$ROOT/cervello/gate-pubblicazione.sh" ]; then
  # shellcheck source=cervello/gate-pubblicazione.sh
  . "$ROOT/cervello/gate-pubblicazione.sh"
  _staged="$(git diff --cached --name-only 2>/dev/null || true)"
  if [ -n "$_staged" ] && ! perimetro_ok "$_staged"; then
    _fuori="$(printf '%s\n' "$_staged" | grep -vE '^(MyCity-Vault|consegne|creativi|memoria-squadra)/' | grep -v '^$')"
    echo "" >&2
    echo "⛔ COMMIT BLOCCATO — su main il CODICE passa da una PR, non da un commit a mano (AR-332):" >&2
    printf '%s\n' "$_fuori" | head -8 | sed 's/^/  → /' >&2
    echo "" >&2
    echo "Spostali su un ramo di lavoro e aprine una PR:" >&2
    echo "  git reset HEAD -- <file>   ·   git checkout -b fix/<nome>   ·   git add <file> && git commit" >&2
    echo "" >&2
    echo "Bypass consapevole (sconsigliato, solo per un'emergenza vera): git commit --no-verify." >&2
    exit 1
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# 3) 🔑 GATE SEGRETI (AR-004) — nessun token reale nella storia. Senza node o senza lo scanner non
#    blocchiamo il lavoro: avvisiamo e lasciamo passare (il giro fa da seconda rete). Meglio non
#    rompere i commit su una macchina senza node.
if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  pre-commit: node non trovato — scan-segreti saltato (il giro resta come seconda rete)." >&2
  exit 0
fi
if [ ! -f "$SCAN" ]; then
  echo "⚠️  pre-commit: $SCAN mancante — scan-segreti saltato." >&2
  exit 0
fi

# Scansiona SOLO i file staged (git diff --cached): veloce e mirato al commit in corso.
if ! node "$SCAN" --staged >/dev/null 2>&1; then
  echo "" >&2
  echo "⛔ COMMIT BLOCCATO — possibile SEGRETO REALE nei file staged (AR-004):" >&2
  echo "" >&2
  node "$SCAN" --staged 2>&1 | tail -12 >&2 || true
  echo "" >&2
  echo "→ Rimuovi il valore dal file (usa un *.example senza valori reali), RUOTA il segreto se era" >&2
  echo "  reale, poi ri-committa. Bypass consapevole (sconsigliato): git commit --no-verify." >&2
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# 4) 🚧 GATE DELLE PROVE DEL CANTIERE (lotto 29) — una prova che non può dimostrare niente non entra
#    nella storia. Scatta SOLO quando il commit tocca `cantiere-difetti.json`, cioè quando qualcuno
#    sta chiudendo o riparando un difetto: negli altri commit non ha niente da dire e non rallenta.
#
#    Perché sta qui e non solo nella skill: una skill è un mansionario, e un mansionario vale finché
#    qualcuno lo legge. I due errori che questo controllo impedisce — la prova con un OR dentro
#    (AR-178) e la prova condivisa che non nomina i suoi difetti (AR-254) — sono costati due
#    chiusure false, tutte e due fatte da chi lo standard lo conosceva. Un cancello che parte da solo
#    è l'unica forma di regola che non dipende dalla memoria di chi lavora.
#
#    Usa `--solo-prove`: istantaneo, nessun processo esterno. Il cancello pieno (typecheck, test)
#    resta a `node cervello/cancello-lotto.mjs`, che si lancia prima di consegnare.
if git diff --cached --name-only --diff-filter=ACM | grep -q "auto-coscienza/cantiere-difetti.json"; then
  GATE="$ROOT/cervello/cancello-lotto.mjs"
  if [ -f "$GATE" ]; then
    if ! node "$GATE" --solo-prove >/dev/null 2>&1; then
      echo "" >&2
      echo "⛔ COMMIT BLOCCATO — una prova del cantiere non può dimostrare il suo difetto:" >&2
      echo "" >&2
      node "$GATE" --solo-prove 2>&1 | sed -n '/── Le prove ──/,$p' | head -20 >&2 || true
      echo "" >&2
      echo "→ Ogni difetto vuole una prova che diventi ROSSA se QUEL difetto non è riparato." >&2
      echo "  Standard completo: .claude/skills/cantiere/ · Bypass (sconsigliato): git commit --no-verify." >&2
      exit 1
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# 5) 👁️ SORVEGLIANTE DEL DELTA (30/7) — quello che sto AGGIUNGENDO non deve introdurre un difetto.
#
#    Nato da Nicola: «ogni volta che ti chiedo di ricontrollare il lavoro trovi problemi che tu stesso
#    hai creato risolvendo i difetti». I quattro cancelli qui sopra guardano tre classi (sintassi,
#    perimetro di main, segreti) più le prove del cantiere: nessuno guarda se le righe nuove
#    reintroducono una malattia già censita, accecano la mutazione che proteggeva un fix vecchio, o
#    dichiarano un freno che non esiste.
#
#    Guarda SOLO le righe aggiunte, quindi parte verde per costruzione e non porta debito storico:
#    l'unica cosa che può farlo diventare rosso è una regressione introdotta adesso. È la taratura di
#    stampo-metro.mjs — un cancello che parte rosso su mezzo repo viene disattivato entro la settimana.
#
#    Fail-closed solo se node c'è, come lo scan-segreti: un cancello che si spegne quando manca uno
#    strumento non è un cancello, ma non posso pretendere node su ogni macchina che committa.
if command -v node >/dev/null 2>&1 && [ -f "$ROOT/cervello/sorvegliante.mjs" ]; then
  _sv="$(node "$ROOT/cervello/sorvegliante.mjs" --staged 2>&1)"
  _sv_code=$?
  # exit 1 = una voce grave nel delta → blocca. exit 2 = cieco (registri illeggibili) → si DICHIARA e
  # si passa: bloccare su una misura che non c'è stata insegnerebbe ad aggirare il cancello per un
  # motivo che non è un difetto. exit 0 = nulla di grave.
  if [ "$_sv_code" = "1" ]; then
    echo "" >&2
    echo "⛔ COMMIT BLOCCATO — le righe che stai aggiungendo introducono un difetto noto:" >&2
    echo "" >&2
    printf '%s\n' "$_sv" | grep -A3 "^❌" | head -24 >&2
    echo "" >&2
    echo "→ Non è debito ereditato: è il delta di questo commit. Curalo, o dichiaralo esente col PERCHÉ" >&2
    echo "  (cervello/malattie.json · cervello/mutanti.json). Bypass consapevole: git commit --no-verify." >&2
    exit 1
  elif [ "$_sv_code" = "2" ]; then
    echo "⚪ sorvegliante: non ho potuto misurare il delta (cieco, non verde)." >&2
  fi
fi

# 📐 LA FORMA DEI JSON (AR-511, 3/8) — un file riscritto tutto per cambiarne una parte.
#
# Il freno esisteva dal 30/7 e girava SOLO nel cancello del lotto, cioè in CI. Risultato: lo stesso
# errore è passato due volte, e tutte e due le volte l'ha visto Nicola prima della macchina — il 30/7
# su apprendimento.json (+12.147/−12.124) e il 3/8 sul cantiere (+8.975/−8.895, per aggiungere
# quattro schede). Un guardiano giusto al posto sbagliato: al commit non c'era nessuno, e in CI arriva
# quando la PR è già scritta e già illeggibile.
#
# Come il sorvegliante: exit 1 blocca, exit 2 si dichiara e passa (senza `origin/main` — clone
# superficiale, primo commit — non ha misurato, e bloccare su una misura mancata insegna ad aggirare).
if command -v node >/dev/null 2>&1 && [ -f "$ROOT/cervello/forma-json.mjs" ]; then
  _fj="$(node "$ROOT/cervello/forma-json.mjs" --staged 2>&1)"
  _fj_code=$?
  if [ "$_fj_code" = "1" ]; then
    echo "" >&2
    echo "⛔ COMMIT BLOCCATO — stai riscrivendo un JSON tutto per cambiarne una parte:" >&2
    printf '%s\n' "$_fj" | grep "^  ❌" >&2
    echo "" >&2
    echo "→ Il contenuto può essere giusto: è la FORMA che rende la PR illeggibile e il conflitto" >&2
    echo "  totale per chiunque altro tocchi quel file. Riscrivilo con l'indentazione che aveva:" >&2
    echo "  JSON.stringify(dati, null, <gli spazi di origin/main>). Bypass: git commit --no-verify." >&2
    exit 1
  elif [ "$_fj_code" = "2" ]; then
    echo "⚪ forma dei JSON: non ho potuto misurare (manca origin/main). Cieco non è verde." >&2
  fi
fi

exit 0
