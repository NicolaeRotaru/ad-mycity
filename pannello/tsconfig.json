{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // AR-232 — la decisione dell'autopilota vive in un modulo puro che ANCHE il cervello esegue
    // (cervello/test/secondo-parere-sul-contenuto.test.mjs lo importa con Node). Node ESM pretende
    // l'estensione nel percorso; senza questo flag TypeScript la rifiuta. Il modulo e uno solo: e la
    // richiesta esplicita del fix («le due meta usano lo stesso metro»).
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
