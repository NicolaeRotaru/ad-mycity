[Unit]
Description=MyCity AD — monitoraggio web continuo (Ondata 3, motore AI Cursor 'agent' o Claude 'claude')
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mycity
WorkingDirectory=/opt/mycity/ad-mycity
EnvironmentFile=/opt/mycity/ad-mycity/cervello/vps/.env
# HOME serve al motore per trovare il login/config (~/.cursor o ~/.claude)
Environment=HOME=/home/mycity
# PATH che include la bin utente: Cursor CLI ('agent') si installa in ~/.local/bin.
Environment=PATH=/home/mycity/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Fuso di Piacenza: gli orari scritti in memoria devono essere ora-di-parete italiana (non UTC).
Environment=TZ=Europe/Rome
# AR-163/AR-305 — la cintura che mancava: senza questi due, un monitoraggio appeso resta appeso PER
# SEMPRE (Type=oneshot senza timeout non scade mai) e il timer di domani non parte nemmeno. Sono gli
# stessi valori di mycity-giro.service: la protezione era stata applicata al giro e ai quattro ritmo,
# e monitora — il terzo gemello — era stato dimenticato.
TimeoutStartSec=3600
TimeoutStopSec=120
ExecStart=/usr/bin/env bash /opt/mycity/ad-mycity/cervello/monitora.sh
